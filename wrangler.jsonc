{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finzi-unconfigured",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": false
  },
  "env": {
    "staging": {
      "name": "finzi-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "finzi-staging"
        }
      ],
      "triggers": {
        "crons": []
      },
      "vars": {
        "APP_URL": "",
        "SUPABASE_URL": "",
        "TELEGRAM_BOT_USERNAME": ""
      }
    }
  }
}
