{
  "name": "finzi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autenticación de Finzi con Next.js y Supabase.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "supabase:reset": "node scripts/supabase-local.mjs db reset --local",
    "supabase:env": "node scripts/local-env.mjs",
    "deletion:worker": "node scripts/deletion-worker.mjs",
    "deletion:check:runtime": "node scripts/deletion-workerd-local.mjs",
    "telegram:recovery": "node scripts/telegram-recovery.ts",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "telegram:bot": "node --env-file-if-exists=.env.telegram.local telegram-bot/index.ts",
    "telegram:check": "node --env-file-if-exists=.env.telegram.local telegram-bot/index.ts --check",
    "infra:check": "node scripts/check-infrastructure.mjs",
    "cloudflare:build": "opennextjs-cloudflare build --env staging",
    "cloudflare:bundle": "wrangler deploy --env staging --dry-run --outdir .cloudflare-bundle",
    "cloudflare:preview": "opennextjs-cloudflare preview --env staging",
    "staging:preflight": "node scripts/staging-migrations.mjs preflight",
    "staging:migrations:plan": "node scripts/staging-migrations.mjs plan",
    "staging:migrations:apply": "node scripts/staging-migrations.mjs apply",
    "staging:schema": "node scripts/staging-schema.mjs",
    "staging:validate": "node scripts/staging-validation.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "grammy": "1.46.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "supabase": "3.1.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.163.0"
  }
}
