# La web usa URL y clave publicable; Telegram requiere credenciales locales del runtime.
# Nunca usar service_role para solicitudes financieras.
# URL y clave PUBLICABLE del proyecto (no son claves administrativas).
# Solo se usan en servidor: no hay cliente Supabase en el navegador.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Origen canónico del servidor, sin barra final. En local, ejecutar pnpm supabase:env.
APP_URL=

# Telegram: public username for the web integration. No token is exposed to the browser.
TELEGRAM_BOT_USERNAME=
# Bot runtime only (.env.telegram.local); provision with pnpm telegram:setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DATABASE_URL=
FINZI_TELEGRAM_STORE=
FINZI_TELEGRAM_KEY_PATH=
